rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }
    // Published assets (product + blog images) are public-read; only admin writes.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
